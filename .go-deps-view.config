# go-deps-view layers config (https://github.com/candy-tools/go-deps-view): lays out the
# dependency graph along the documented tiers app/ → internal/ → libs/ (see docs/agents/architecture.md).
layers:
  - name: Entry point
    description: The binary; hands off to the CLI
    entrypoint: true
    packages: [.]

  - name: App
    description: Glue, transport and wiring; no business rules
    packages: [app, "*"]

  - name: Business modules
    description: One concern each; never import app/ or each other
    packages: [internal]

  - name: Foundation
    description: Agnostic libraries; never import app/ or internal/
    packages: [libs]
